# Postgres connection string.
# Local dev (docker-compose): postgresql://leadsignal:leadsignal@localhost:5432/leadsignal
# Cloud Run + Cloud SQL:      postgresql://USER:PASS@localhost/leadsignal?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://leadsignal:leadsignal@localhost:5432/leadsignal

# Anthropic API key (analyst + explanations). https://platform.claude.com/
ANTHROPIC_API_KEY=

# Shared demo password required to enter the app.
APP_PASSWORD=

# Secret used to sign the auth cookie (openssl rand -hex 32).
AUTH_COOKIE_SECRET=
